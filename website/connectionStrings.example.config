<?xml version="1.0" encoding="utf-8"?>
<!-- คัดลอกไฟล์นี้เป็น connectionStrings.config แล้วใส่รหัสผ่านจริง (ไฟล์จริงไม่เก็บใน git) -->
<connectionStrings>
  <add name="DOCDBConnectionString"
       connectionString="Host=localhost;Port=5432;Database=docdb;Username=csproject;Password=__PASSWORD__;Maximum Pool Size=50"
       providerName="Npgsql" />
</connectionStrings>